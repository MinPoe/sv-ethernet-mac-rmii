# Quartus settings for DE1-SoC (Cyclone V 5CSEMA5F31C6)

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY eth_mac_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "14:00:00 November 23, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256

# RTL sources
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/crc32.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmii_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rx_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmii_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/tx_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/eth_regs.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/eth_mac_top.sv

# Clock constraint: 50 MHz REF_CLK
set_global_assignment -name SDC_FILE eth_mac.sdc

# DE1-SoC pin assignments for RMII PHY (directly from board manual)
# RMII operates on 50 MHz from PHY / REF_CLK
# Directly connect to GPIO, manual wiring via breakout board to LAN8720

# If directly wired via GPIO-0 header, choose your mapping below
# and uncomment once pinout is confirmed on your breakout wiring
#
# set_location_assignment PIN_AC18 -to clk
# set_location_assignment PIN_AB12 -to rst_n
# set_location_assignment PIN_?? -to txd[0]
# set_location_assignment PIN_?? -to txd[1]
# set_location_assignment PIN_?? -to tx_en
# set_location_assignment PIN_?? -to rxd[0]
# set_location_assignment PIN_?? -to rxd[1]
# set_location_assignment PIN_?? -to crs_dv

# I/O standard for 3.3V GPIO
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top